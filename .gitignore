# Photos sources brutes (shoot maillots + reportage match) : trop lourdes
# (~700 Mo de fichiers 6240x4160). On ne versionne que les versions web
# optimisées, réintégrées sous des noms propres. Les originaux restent en local.
/public/images/Matchs/
/public/images/Maillots/Shooting/
/public/images/Maillots/WhatsApp Image*
# Photos joueurs : sources brutes (avant détourage). Seules les .png détourées
# sont versionnées et déployées ; les originaux restent en local.
/public/players/*.jpeg
/public/players/*.jpg
# Dossiers sources par joueur (NOM/ avec les 4 poses brutes) : locaux uniquement.
/public/players/*/
# Poses -2 (bras croisés) et -3 (bras croisés 3/4) : détourées et prêtes,
# gardées en local pour un usage ultérieur. Seules -1 (base) et -4 (célébration/
# hover) sont déployées. Retirer ces lignes pour versionner -2/-3.
/public/players/*-2.png
/public/players/*-3.png

# Windows Explorer junk
desktop.ini
